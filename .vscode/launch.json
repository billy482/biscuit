	"version": "0.2.0",
	"configurations": [
		{
			"args": ["backup", "-p"],
			"console": "integratedTerminal",
			"name": "biscuit: backup",
			"program": "${workspaceFolder}/biscuit.py",
			"request": "launch",
			"type": "debugpy"
		},
		{
			"args": ["backup", "list"],
			"console": "integratedTerminal",
			"name": "biscuit: backup list",
			"program": "${workspaceFolder}/biscuit.py",
			"request": "launch",
			"type": "debugpy"
		},
		{
			"args": ["config", "generate", "-f", "json"],
			"console": "integratedTerminal",
			"name": "biscuit: config gen",
			"program": "${workspaceFolder}/biscuit.py",
			"request": "launch",
			"type": "debugpy"
		},
		{
			"args": ["config", "show"],
			"console": "integratedTerminal",
			"name": "biscuit: config show",
			"program": "${workspaceFolder}/biscuit.py",
			"request": "launch",
			"type": "debugpy"
		},
		{
			"args": ["key", "gen"],
			"console": "integratedTerminal",
			"name": "biscuit: key gen",
			"program": "${workspaceFolder}/biscuit.py",
			"request": "launch",
			"type": "debugpy"
