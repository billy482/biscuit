			"type": "debugpy"
		},
		{
			"args": ["key", "test"],
			"console": "integratedTerminal",
			"name": "biscuit: key test",
			"program": "${workspaceFolder}/biscuit.py",
			"request": "launch",
			"type": "debugpy"
